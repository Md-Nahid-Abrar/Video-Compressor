        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপটি সামনে না থাকায় কম্প্রেশন বন্ধ হয়ে গেছে। অ্যাপ খোলা রেখে আবার চেষ্টা করুন।"
          }
        }
      }
    },
    "Compression was stopped before it finished. Try again." : {
