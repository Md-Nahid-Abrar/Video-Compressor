    "Compression was interrupted because the app left the foreground. Keep the app open and try again.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি সামনে না থাকায় কম্প্রেশন বন্ধ হয়ে গেছে। অ্যাপ খোলা রেখে আবার চেষ্টা করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compresión se interrumpió porque la app pasó a segundo plano. Mantén la app abierta e inténtalo de nuevo."
          }
        }
      }
    },
    "Compression was stopped before it finished. Try again.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ হওয়ার আগেই কম্প্রেশন বন্ধ হয়ে গেছে। আবার চেষ্টা করুন।"
