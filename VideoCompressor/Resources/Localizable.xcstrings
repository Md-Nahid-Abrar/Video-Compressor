          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফটো লাইব্রেরিতে ভিডিও যোগ করার অনুমতি Video Compressor-এর নেই। সেটিংস থেকে অনুমতি দিতে পারেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Video Compressor no tiene permiso para añadir vídeos a tu fototeca. Puedes permitirlo en Ajustes."
          }
        }
      }
    },
    "Video compressed successfully": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিডিও সফলভাবে কম্প্রেস হয়েছে"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeo comprimido correctamente"
          }
        }
      }
    },
    "Videos in %@ format aren't supported. Choose an MP4, MOV or M4V video.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ফরম্যাটের ভিডিও সমর্থিত নয়। একটি MP4, MOV বা M4V ভিডিও বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos en formato %@ no son compatibles. Elige un vídeo MP4, MOV o M4V."
          }
        }
      }
    },
    "Without Visible Quality Loss": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চোখে পড়ার মতো মান না হারিয়ে"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin pérdida visible de calidad"
          }
        }
      }
    },
    "You can leave the app while this finishes, but don't force-quit it or compression will stop.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি শেষ হওয়ার সময় আপনি অ্যাপ থেকে বেরিয়ে যেতে পারেন, তবে জোর করে বন্ধ করবেন না, নইলে কম্প্রেশন থেমে যাবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes salir de la app mientras termina, pero no la cierres a la fuerza o la compresión se detendrá."
          }
        }
      }
    },
