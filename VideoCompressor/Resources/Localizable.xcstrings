    },
    "This file doesn't contain any video. Choose a different video.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলে কোনো ভিডিও নেই। অন্য একটি ভিডিও বেছে নিন।"
