    "There isn't enough free storage to compress this video. Free up some space and try again.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিও কম্প্রেস করার মতো যথেষ্ট ফাঁকা জায়গা নেই। কিছু জায়গা খালি করে আবার চেষ্টা করুন।"
          }
