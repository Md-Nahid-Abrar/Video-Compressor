      }
    },
    "This video is copy-protected and can't be compressed. Choose a different video.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিওটি কপি-সুরক্ষিত, তাই কম্প্রেস করা যাবে না। অন্য একটি ভিডিও বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo está protegido contra copia y no se puede comprimir. Elige otro vídeo."
          }
        }
      }
    },
    "This video isn't encoded with H.264 or HEVC. Choose an MP4, MOV or M4V video that uses one of those formats.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিওটি H.264 বা HEVC দিয়ে এনকোড করা নয়। এই ফরম্যাটগুলোর একটি ব্যবহার করে এমন MP4, MOV বা M4V ভিডিও বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo no está codificado en H.264 ni HEVC. Elige un vídeo MP4, MOV o M4V que use uno de esos formatos."
          }
        }
      }
    },
    "This video was already well compressed.": {
      "localizations": {
        "bn": {
